# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local embedding model (Sentence Transformers). Keep the same model for A/B/C.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# cuda | cpu ; leave empty for auto-detect
EMBEDDING_DEVICE=
